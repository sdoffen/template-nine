{
  "$schema": "http://json.schemastore.org/template",
  "identity": "Template9.DbDocker",
  "name": "Docker Database",
  "shortName": "db-docker",
  "description": "Adds a docker-compose.yaml configured for a database provider.",
  "sourceName": "Template9",
  "tags": {
    "language": "Docker",
    "type": "item"
  },
  "symbols": {
    "provider": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Database Provider",
      "defaultValue": "postgres",
      "choices": [
        {
          "choice": "postgres",
          "displayName": "PostgreSQL"
        },
        {
          "choice": "mysql",
          "displayName": "MySQL"
        },
        {
          "choice": "mssql",
          "displayName": "Microsoft SQL Server"
        }
      ]
    },
    "dbname": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "appdb",
      "replaces": "$(DatabaseName)"
    },
    "dbuser": {
      "type": "parameter",
      "datatype": "string"
    },
    "dbpwd": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "StrongPassword123!",
      "replaces": "$(DatabasePwd)"
    },
    "dbport": {
      "type": "parameter",
      "datatype": "int"
    },
    "DbUserGenerated": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "dbname",
        "steps": [
          { "regex": "$", "replacement": "_user" }
        ]
      }
    },
    "DbUserReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "dbuser",
        "fallbackVariableName": "DbUserGenerated"
      },
      "replaces": "$(DatabaseUser)"
    },
    "DbPortGenerated": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(provider == 'mssql')",
            "value": "1433"
          },
          {
            "condition": "(provider == 'mysql')",
            "value": "3306"
          },
          {
            "condition": "(provider == 'postgres')",
            "value": "5432"
          },
          {
            "condition": "true",
            "value": "5432"
          }
        ]
      }
    },
    "DbPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "dbport",
        "fallbackVariableName": "DbPortGenerated"
      },
      "replaces": "$(DatabasePort)"
    }
  },
  "sources": [
    {
      "source": "../content/docker",
      "condition": "(provider == 'postgres')",
      "include": [
        "docker-compose.postgres.yaml"
      ],
      "rename": {
        "docker-compose.postgres.yaml": "docker-compose.yaml"
      }
    },
    {
      "source": "../content/docker",
      "condition": "(provider == 'mysql')",
      "include": [
        "docker-compose.mysql.yaml"
      ],
      "rename": {
        "docker-compose.mysql.yaml": "docker-compose.yaml"
      }
    },
    {
      "source": "../content/docker",
      "condition": "(provider == 'mssql')",
      "include": [
        "docker-compose.mssql.yaml"
      ],
      "rename": {
        "docker-compose.mssql.yaml": "docker-compose.yaml"
      }
    }
  ]
}